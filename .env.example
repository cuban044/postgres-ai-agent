# Copia a .env. Nunca subas .env al repositorio.
# En esta máquina PostgreSQL de desarrollo escucha en 55432.
# En Docker Compose escucha en 5432 (ver docker-compose.yml).

DATABASE_URL=postgresql://agente_app:cambiar@127.0.0.1:5432/agente
TEST_DATABASE_URL=postgresql://agente_app:cambiar@127.0.0.1:5432/agente_test
DB_POOL_MIN=1
DB_POOL_MAX=5
AGENT_MAX_STEPS=6

# Proveedor OpenAI-compatible (opcional; sin clave se usa mock)
LLM_BASE_URL=
LLM_MODEL=mock
LLM_API_KEY=
LLM_TIMEOUT=60

# Costo estimado (opcional; consultar tarifa vigente)
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=

# Protección del webhook
WEBHOOK_SECRET=
